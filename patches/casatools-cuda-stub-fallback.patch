+# Ensure libcuda.so.1 can be resolved before loading C++ bindings (__casac__)
+def __ensure_cuda_driver():
+    import ctypes
+    import os
+    try:
+        # Try loading host system's NVIDIA driver
+        ctypes.CDLL('libcuda.so.1')
+    except OSError:
+        # No NVIDIA driver on host system. Preload the bundled CUDA driver stub with RTLD_GLOBAL
+        pkg_dir = os.path.dirname(__file__)
+        stub_candidates = [
+            os.path.join(pkg_dir, '__casac__', 'lib', 'stubs', 'libcuda.so'),
+            os.path.join(os.environ.get('CONDA_PREFIX', ''), 'targets', 'x86_64-linux', 'lib', 'stubs', 'libcuda.so'),
+        ]
+        for stub in stub_candidates:
+            if os.path.isfile(stub):
+                try:
+                    ctypes.CDLL(stub, mode=ctypes.RTLD_GLOBAL)
+                    break
+                except Exception:
+                    pass
+
+__ensure_cuda_driver()
+
